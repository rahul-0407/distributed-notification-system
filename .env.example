
PORT=5000
NODE_ENV=production # Use 'production' in live server deployment

DATABASE_URL="postgresql://postgres:secure_db_pass@postgres:5432/notification_db?sslmode=disable"


JWT_SECRET="production-super-secret-jwt-key-replace-in-env"

KAFKA_BROKERS="kafka:29092"
KAFKA_CLIENT_ID="notification-backend"
KAFKA_GROUP_ID="notification-consumers"
KAFKAJS_NO_PARTITIONER_WARNING=1

# Optional Kafka SASL / SSL Security (For Cloud Kafka e.g., Confluent Cloud, Aiven)
# KAFKA_SASL_USERNAME="your-kafka-username"
# KAFKA_SASL_PASSWORD="your-kafka-password"
# KAFKA_SASL_MECHANISM="scram-sha-512"

REDIS_URL="redis://redis:6379"


RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672"

# Frontend API Configuration (Baked into build at build time)
# For local dev: leave blank (defaults to relative '/api' via Vite proxy)
# For production: set to your public domain e.g., VITE_API_URL="https://api.yourdomain.com"
VITE_API_URL=""
